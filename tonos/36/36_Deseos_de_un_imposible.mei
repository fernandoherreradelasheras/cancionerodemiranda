                              <rend label="nota de paso ascendente">P</rend>
                           </harm>
                           <harm type="rdiss" n="6" staff="2" tstamp="3" place="above">
                              <rend label="bordadura superior">N</rend>
                           </harm>
                        </rdg>
                     </app>
                  </measure>
