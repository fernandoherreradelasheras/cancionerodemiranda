                           <note xml:id="a57_2" dur="1" dots="1" pname="e" oct="4">
                              <verse n="1">
                                 <syl wordpos="t">ga.</syl>
                              </verse>
                           </note>
                        </layer>
                     </staff>
                     <staff n="3">
                        <layer n="1">
                           <note xml:id="nn77hmt" dur="1" dots="1" pname="e" oct="3" facs="#zone-220">
                              <verse n="1">
                                 <syl wordpos="t">ga.</syl>
                              </verse>
                           </note>
                        </layer>
                     </staff>
                     <staff n="4">
                        <layer n="1">
                           <note xml:id="g73_m57_1" dur="1" dots="1" pname="e" oct="3"/>
                        </layer>
                     </staff>
                     <tie startid="#g73_m57_1" endid="#g73_m58_1"/>
                     <tie startid="#nnzc91a" endid="#n19kboza"/>
                     <tie startid="#nn77hmt" endid="#n1vtr3jf"/>
                     <tie startid="#a57_2" endid="#a58_1"/>
                  </measure>
                  <measure n="58" right="end">
                     <staff n="1">
                        <layer n="1">
                           <note xml:id="n19kboza" dur="1" dots="1" pname="g" oct="4" facs="#zone-219"/>
