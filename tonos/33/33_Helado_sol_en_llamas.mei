                                 <verse n="1">
                                    <syl con="b">de</syl>
                                    <syl con="d" wordpos="i">o</syl>
                                 </verse>
                              </note>
                           </corr>
                        </layer>
                        <annot plist="#ct1deo65">Semibreve ennegrecida en el manuscrito, de dos mínimas. Se reduce a mínima para que la voz vuelva a coincidir con las demás en el c. 66 (véase la nota del c. 59).</annot>
                     </staff>
                     <staff n="2">
                        <layer n="1">
                           <supplied xml:id="st2go65" reason="mínima que falta en el compás" resp="#FHH">
                              <note xml:id="nt2go65" dur="2" pname="a" oct="4"/>
                           </supplied>
                           <note dur="2" pname="b" accid="f" oct="4">
                              <verse n="1">
                                 <syl wordpos="t">zo</syl>
                              </verse>
                           </note>
                           <note xml:id="id948" dur="2" pname="b" accid.ges="f" oct="4">
                              <verse n="1">
                                 <syl con="b">de</syl>
                                 <syl con="d" wordpos="i">o</syl>
                              </verse>
                           </note>
                        </layer>
                        <annot plist="#st2go65">Semibreve ennegrecida en el manuscrito, de dos mínimas, que se prolonga una mínima más, hasta el primer tiempo del c. 65. Así «zo» y «de oír» coinciden con las del tiple 1º y la mínima de «de oír», que es lo que trae el manuscrito, queda como está. Sin la prolongación faltaría una mínima en el compás y el si♭4 de «zo» chocaría con el do5 del tiple 1º y el la3 del tenor.</annot>
                     </staff>
                     <staff n="3">
                        <layer n="1">
                           <note dur="2" pname="f" oct="4">
                              <verse n="1">
