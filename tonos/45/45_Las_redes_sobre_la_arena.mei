                     <annot plist="#c91380">Do# con el sostenido explicitado en el manuscrito del Cancionero de Miranda pero sin el signo de sostenido en el Cancionero Poético Musical de Lisboa. Nos inclinamos por la opción del CPMHL porque si bien las disonancias que se dan entre los dos tiples con Do# se podrían considerar preparadas se crearía movimiento paralelo de quinta disminuida. Mantener Do# y forzar la lectura del siguiente Si aplicando aún el bemol del compás anterior resolvería el movimiento paralelo pero introduciría un salto interválico de segunda aumentada considerado difícil de cantar y altmente infrecuente en la época.</annot>
                     <slur staff="2" startid="#n481338" endid="#n844315"/>
                     <app type="dissonant_analysis">
                        <lem/>
                        <rdg type="dissonant_analysis">
                           <harm type="rdiss" n="8" staff="2" tstamp="1.5" place="above">
                              <rend label="échappée superior inversa">J</rend>
                           </harm>
                           <harm type="rdiss" n="8" staff="2" tstamp="2.5" place="above">
                              <rend label="nota de paso descendente">p</rend>
                           </harm>
                           <harm type="rdiss" n="8" staff="2" tstamp="3" place="above">
                              <rend label="nota de paso descendente acentuada">v</rend>
                           </harm>
                           <harm type="rdiss" n="10" staff="1" tstamp="3" place="above">
                              <rend label="nota de paso descendente acentuada">v</rend>
                           </harm>
                           <harm type="rdiss" n="8" staff="2" tstamp="3.5" place="above">
                              <rend label="nota de paso descendente">p</rend>
                           </harm>
                           <harm type="rdiss" n="10" staff="1" tstamp="3.5" place="above">
                              <rend>l</rend>
                           </harm>
                           <harm type="rdiss" n="8" staff="2" tstamp="4.5" place="above">
                              <rend label="nota de paso descendente">p</rend>
                           </harm>
                        </rdg>
                     </app>
                  </measure>
