      <encodingDesc>
         <classDecls>
            <taxonomy>
               <category xml:id="vgrp-entrada-tenor">
                  <label>Entrada del tenor, cc. 34-38</label>
                  <desc>Entrada del tenor a un compás de diferencia en cada una de las fuentes. 
                  El tenor entra un compás más tarde en el Cancionero de Miranda con respecto al
                  Cancionero Poético-Musical Hispánico de Lisboa. El tiple 1º en el compás 34 y el
                  tiple 2º en el 36 se ajustan a la armonía resultante de esa entrada distinta.</desc>
               </category>
               <category xml:id="vgrp-duraciones">
                  <label>Reparto de duraciones</label>
                  <desc>Lugares en que las dos fuentes reparten de otro modo un mismo total de
                     duración, con puntillo en una y sin él en la otra, o partiendo una nota larga.</desc>
               </category>
               <category xml:id="vgrp-tiple2-end">
                  <label>Final del tiple 2º</label>
               </category>
            </taxonomy>
         </classDecls>
      </encodingDesc>
